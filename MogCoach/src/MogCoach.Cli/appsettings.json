{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "Llm": {
    "BaseUrl": "http://shared-services:11434",
    "Model": "qwen2.5-vl-7b-instruct",
    "ApiKey": "",
    "TimeoutSeconds": 900,
    "Temperature": 0.2,
    "MaxTokens": 1536
  },

  "Screenpipe": {
    "DbPath": "~/.screenpipe/db.sqlite",
    "BaseUrl": "http://localhost:3030",
    "FfmpegPath": "ffmpeg",
    "FrameCacheDir": "captures/frames",
    "ClockOffsetSeconds": 0
  },

  "Iinact": {
    "WebSocketUrl": "ws://127.0.0.1:10501/ws"
  },

  "Segmenter": {
    "IdleGapSeconds": 20,
    "MinPullSeconds": 15
  },

  "References": {
    "RotationsDirectory": "reference-data/rotations",
    "AoeShapesFile": "reference-data/aoe/shapes.json"
  },

  "FfLogs": {
    "ClientId": "",
    "ClientSecret": "",
    "TokenUrl": "https://www.fflogs.com/oauth/token",
    "ApiUrl": "https://www.fflogs.com/api/v2/client",
    "Percentiles": [ 25, 50, 75, 95, 99 ],
    "EncounterIds": {}
  },

  "Analysis": {
    "MaxKeyframes": 6,
    "FramesPerKeyframe": 2,
    "KeyframeWindowBeforeSeconds": 3,
    "KeyframeWindowAfterSeconds": 1,
    "EvidenceDir": "reports/evidence",
    "MaxImageEdge": 1280
  }
}
